{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".yarnrc.yml"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build:android": {
      "env": [
        "ANDROID_HOME",
        "ORG_GRADLE_PROJECT_newArchEnabled"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/cpp/**",
        "$TURBO_ROOT$/app.plugin.js",
        "$TURBO_ROOT$/react-native.config.js",
        "$TURBO_ROOT$/android/build.gradle",
        "$TURBO_ROOT$/android/src/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/cpp/**",
        "$TURBO_ROOT$/app.plugin.js",
        "$TURBO_ROOT$/react-native.config.js",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/ios/**",
        "!$TURBO_ROOT$/ios/build/**"
      ],
      "outputs": []
    }
  }
}
